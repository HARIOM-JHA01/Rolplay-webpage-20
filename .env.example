# ElevenLabs Conversational AI
# Get your Agent ID from: https://elevenlabs.io/app/conversational-ai
REACT_APP_ELEVENLABS_AGENT_ID=your_agent_id_here

# Optional: Backend API URL for email subscriptions
REACT_APP_API_URL=http://localhost:8001

# Optional: host port for backend when using docker compose
BACKEND_HOST_PORT=8001

# Blog system — backend .env (set in backend/.env)
# MONGODB_URI=mongodb+srv://...
# ADMIN_API_KEY=your_secret_key
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=mg.rolplay.ai
# MAILGUN_FROM=RolPlay <noreply@rolplay.ai>
# SITE_URL=https://rolplay.ai
